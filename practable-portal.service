[Unit]
Description=Run Practable Portal System Info on startup
Documentation=https://github.com/practable/practable-portal
After=network.target


[Service]
Type=simple
User=practable
WorkingDirectory=/home/practable/practable-portal/
ExecStart= /home/practable/practable-portal/.portalvenv/bin/python3 /home/practable/practable-portal/portal-main.py
Restart=always

[Install]
WantedBy=multi-user.target



